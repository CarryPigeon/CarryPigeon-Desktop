# Mock switch: set to true to use local mock services
VITE_USE_MOCK_API=false

# Mock-only settings
# VITE_MOCK_MODE=store | protocol (effective only when VITE_USE_MOCK_API=true)
VITE_MOCK_MODE=store
# Disable required-plugin gate in mock mode (set false to re-enable gate testing)
VITE_MOCK_DISABLE_REQUIRED_GATE=true
VITE_MOCK_LATENCY_MS=120
VITE_MOCK_SERVER_SOCKET=mock://handshake

# Legacy switch: treat voice-call as a bundled plugin served from /plugins/voice-call/
VITE_USE_LOCAL_VOICE_CALL_PLUGIN=false
# Bundled plugin source (generic): comma-separated plugin ids served from /plugins/<id>/
# Available ids: voice-call, theme, markdown, group-notice, ai-summary
# - Unset: in every build (dev + release) these four bundled plugins are enabled by default:
#     theme,markdown,group-notice,ai-summary
# - Non-empty list: exactly those ids are enabled
# - Empty string: bundled plugin source disabled
# Enabled ids are auto-marked installed+enabled in the Plugin Center and load real builds from
# public/plugins/<id>/ (populated by `plugins:build:all` + `plugins:dev:link` at build time).
# VITE_USE_LOCAL_PLUGINS=theme,markdown,group-notice,ai-summary

# Browser `pnpm run dev` joint-debug: Vite proxies same-origin `/api` to the local server
# so CORS preflight on authenticated routes does not block Chrome/WebView fetch.
# Tauri runtime talks to the server origin directly and ignores these.
# VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:8080
# VITE_DEV_WS_PROXY_TARGET=ws://127.0.0.1:18080
