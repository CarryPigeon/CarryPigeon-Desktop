{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "default",
    "description": "Capability for the main window and screenshot overlay",
    "windows": ["main", "screenshot-overlay"],
    "focus": true,
    "permissions": [
        "core:default",
        "core:window:default",
        {
            "identifier": "opener:allow-open-url",
            "allow": [
                { "url": "https://github.com/ShirasawaTopaz/carrypigeon-desktop/releases/latest" },
                { "url": "https://github.com/ShirasawaTopaz/carrypigeon-desktop/releases/*" }
            ]
        },
        "core:tray:default",
        "core:menu:default",
        "core:window:allow-set-size",
        "core:window:allow-set-closable",
        "core:window:allow-hide",
        "core:window:allow-minimize",
        "core:window:allow-maximize",
        "core:window:allow-set-focus",
        "core:window:allow-create",
        "core:window:allow-center",
        "notification:default"
    ]
}
